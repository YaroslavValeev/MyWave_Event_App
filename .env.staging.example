# MyWave Event App — staging environment (no secrets)
# Copy to .env.staging and fill real values. Never commit .env.staging.

APP_NAME=MyWave Event App (Staging)
APP_ENV=staging
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=http://127.0.0.1:8001
# REQUIRED: unique, at least 32 characters
SECRET_KEY=replace-with-staging-secret-key-32chars-min
CORS_ORIGINS=http://127.0.0.1:3001,http://localhost:3001

DATABASE_URL=sqlite:////data/mywave_event_staging.db
# Prefer Postgres on remote staging:
# DATABASE_URL=postgresql+psycopg://mywave:PASSWORD@postgres:5432/mywave_event_staging

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8001
NEXT_PUBLIC_APP_NAME=MyWave Event App (Staging)

ENABLE_TELEGRAM_ADAPTER=0
ENABLE_MAX_ADAPTER=0
ENABLE_AUDIT_LOG=1

OWNER_APPROVAL_EMAIL=y.valeev@gmail.com
PUBLIC_WEB_URL=http://127.0.0.1:3001
OTP_TTL_MINUTES=10

# Optional SMTP (otherwise mail_outbox)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
