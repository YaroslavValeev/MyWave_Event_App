# MyWave Event App — example environment (no secrets)
# Copy to .env and fill real values. Never commit .env.

# --- API ---
APP_NAME=MyWave Event App
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=http://127.0.0.1:8000
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# --- Database ---
DATABASE_URL=sqlite:///./data/mywave_event.db
# Production example:
# DATABASE_URL=postgresql+psycopg://mywave:PASSWORD@127.0.0.1:5432/mywave_event

# --- Redis (optional at Stage 1) ---
REDIS_URL=

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_NAME=MyWave Event App

# --- Feature flags ---
ENABLE_TELEGRAM_ADAPTER=0
ENABLE_MAX_ADAPTER=0
ENABLE_AUDIT_LOG=1

# --- Auth / mail ---
OWNER_APPROVAL_EMAIL=y.valeev@gmail.com
PUBLIC_WEB_URL=http://127.0.0.1:3000
OTP_TTL_MINUTES=10
# Optional SMTP (without it letters go to data/mail_outbox/)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USER=y.valeev@gmail.com
# SMTP_PASSWORD=
# SMTP_FROM=y.valeev@gmail.com
