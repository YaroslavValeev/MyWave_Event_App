# MyWave Event App API — env vars (Stage 1)
# Preferred: copy repo-root .env.example to repo-root .env
# This file documents vars loaded by services/api (pydantic-settings).

# --- Core ---
APP_NAME=MyWave Event App
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=http://127.0.0.1:8000
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# --- Database ---
# Relative paths resolve from the process working directory (prefer repo root).
DATABASE_URL=sqlite:///./data/mywave_event.db

# --- Optional Stage 1 ---
REDIS_URL=
ENABLE_AUDIT_LOG=1
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- App download catalog ---
# Placeholders mean "not connected". Do not put fake APK/IPA URLs here.
MYWAVE_EVENT_APP_ANDROID_DOWNLOAD_URL={{android_download_url}}
MYWAVE_EVENT_APP_IOS_TESTFLIGHT_URL={{ios_testflight_url}}
MYWAVE_EVENT_APP_SOURCE_ARCHIVE_URL={{source_archive_url}}
MYWAVE_EVENT_APP_DOCUMENTATION_URL={{documentation_url}}
