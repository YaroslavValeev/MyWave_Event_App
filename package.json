{
  "name": "mywave-event-app",
  "private": true,
  "version": "0.5.10",
  "description": "MyWave Event App — root scripts",
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev.ps1",
    "dev:web": "npm --prefix apps/web run dev -- --hostname 127.0.0.1 --port 3000",
    "reseed": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/reseed.ps1",
    "test:api": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Set-Location services/api; C:\\tmp\\mw_event_api_venv\\Scripts\\python.exe -m pytest -q\"",
    "smoke:report": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/smoke_event_report.ps1 -ApiBase http://127.0.0.1:8010",
    "dry-run:kazan": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dry_run_kazan.ps1 -ApiBase http://127.0.0.1:8010"
  }
}
